<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon foreground. The launcher applies a large safe-zone crop, so all
    artwork sits inside the central ~66dp of the 108dp canvas. Four calculator
    buttons in a 2x2 grid: +  -  on top, x  =  below, with the = in amber.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Rounded tile behind the buttons -->
    <path
        android:fillColor="#3A3A40"
        android:pathData="M38,34 h32 a10,10 0 0 1 10,10 v20 a10,10 0 0 1 -10,10 h-32 a10,10 0 0 1 -10,-10 v-20 a10,10 0 0 1 10,-10 z" />

    <!-- Top-left button (plus) -->
    <path
        android:fillColor="#5A5A62"
        android:pathData="M46,44 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0 z" />
    <path
        android:fillColor="#F2F2F2"
        android:pathData="M45,40.5 h2 v7 h-2 z" />
    <path
        android:fillColor="#F2F2F2"
        android:pathData="M42.5,43 h7 v2 h-7 z" />

    <!-- Top-right button (minus) -->
    <path
        android:fillColor="#5A5A62"
        android:pathData="M62,44 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0 z" />
    <path
        android:fillColor="#F2F2F2"
        android:pathData="M58.5,43 h7 v2 h-7 z" />

    <!-- Bottom-left button (times) -->
    <path
        android:fillColor="#5A5A62"
        android:pathData="M46,60 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0 z" />
    <path
        android:fillColor="#F2F2F2"
        android:pathData="M43.4,56.6 l5.2,5.2 l-1.4,1.4 l-5.2,-5.2 z" />
    <path
        android:fillColor="#F2F2F2"
        android:pathData="M48.6,56.6 l1.4,1.4 l-5.2,5.2 l-1.4,-1.4 z" />

    <!-- Bottom-right button (equals, amber) -->
    <path
        android:fillColor="#F2A93B"
        android:pathData="M62,60 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0 z" />
    <path
        android:fillColor="#2A2018"
        android:pathData="M58.5,58 h7 v1.8 h-7 z" />
    <path
        android:fillColor="#2A2018"
        android:pathData="M58.5,61.2 h7 v1.8 h-7 z" />
</vector>
