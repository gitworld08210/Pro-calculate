<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon FOREGROUND. The grey rounded tile is drawn by the *background*
    layer (@color/icon_background), which the launcher fills edge-to-edge and then
    masks into whatever shape the device uses (squircle, circle, rounded square).
    That is why the tile always fills the icon with no black corners.

    This foreground holds only the four buttons, kept inside the guaranteed safe
    zone (centres roughly 42..66 on the 108dp canvas) so none of them are clipped.
    + and - on top, x and = below; = is amber with dark-brown bars.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ===== button centres: TL(43,45) TR(65,45) BL(43,67) BR(65,67), r=11 ===== -->

    <!-- Top-left (plus) -->
    <path
        android:fillColor="#54545A"
        android:pathData="M43,45 m-11,0 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0 z" />
    <path
        android:fillColor="#F6F6F6"
        android:pathData="M41.4,39 h3.2 v12 h-3.2 z" />
    <path
        android:fillColor="#F6F6F6"
        android:pathData="M37,43.4 h12 v3.2 h-12 z" />

    <!-- Top-right (minus) -->
    <path
        android:fillColor="#54545A"
        android:pathData="M65,45 m-11,0 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0 z" />
    <path
        android:fillColor="#F6F6F6"
        android:pathData="M59,43.4 h12 v3.2 h-12 z" />

    <!-- Bottom-left (times) -->
    <path
        android:fillColor="#54545A"
        android:pathData="M43,67 m-11,0 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0 z" />
    <path
        android:fillColor="#F6F6F6"
        android:pathData="M38.9,61.9 l8.2,8.2 l-2.3,2.3 l-8.2,-8.2 z" />
    <path
        android:fillColor="#F6F6F6"
        android:pathData="M47.1,61.9 l2.3,2.3 l-8.2,8.2 l-2.3,-2.3 z" />

    <!-- Bottom-right (equals, amber) -->
    <path
        android:fillColor="#F5A623"
        android:pathData="M65,67 m-11,0 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0 z" />
    <path
        android:fillColor="#6B4A12"
        android:pathData="M59,63.4 h12 v2.9 h-12 z" />
    <path
        android:fillColor="#6B4A12"
        android:pathData="M59,67.7 h12 v2.9 h-12 z" />
</vector>
