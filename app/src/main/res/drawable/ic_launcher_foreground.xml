<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon foreground. The launcher crops to the central safe zone (~66 of
    the 108dp canvas), so the tile is drawn large — roughly 24..84 — to fill that
    zone the way the reference icon does. Four buttons in a 2x2 grid: + and - on
    top, x and = below, with the = in amber and dark-brown bars.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Rounded tile, drawn large so it nearly fills the safe zone -->
    <path
        android:fillColor="#2E2E31"
        android:pathData="M34,24 h40 a13,13 0 0 1 13,13 v40 a13,13 0 0 1 -13,13 h-40 a13,13 0 0 1 -13,-13 v-40 a13,13 0 0 1 13,-13 z" />

    <!-- ============ button centres: TL(41,44) TR(67,44) BL(41,70) BR(67,70), r=12 ============ -->

    <!-- Top-left (plus) -->
    <path
        android:fillColor="#4A4A4E"
        android:pathData="M41,44 m-12,0 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0 z" />
    <path
        android:fillColor="#F5F5F5"
        android:pathData="M39.2,37.5 h3.6 v13 h-3.6 z" />
    <path
        android:fillColor="#F5F5F5"
        android:pathData="M34.5,42.2 h13 v3.6 h-13 z" />

    <!-- Top-right (minus) -->
    <path
        android:fillColor="#4A4A4E"
        android:pathData="M67,44 m-12,0 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0 z" />
    <path
        android:fillColor="#F5F5F5"
        android:pathData="M60.5,42.2 h13 v3.6 h-13 z" />

    <!-- Bottom-left (times) -->
    <path
        android:fillColor="#4A4A4E"
        android:pathData="M41,70 m-12,0 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0 z" />
    <path
        android:fillColor="#F5F5F5"
        android:pathData="M36.6,64.1 l8.8,8.8 l-2.5,2.5 l-8.8,-8.8 z" />
    <path
        android:fillColor="#F5F5F5"
        android:pathData="M45.4,64.1 l2.5,2.5 l-8.8,8.8 l-2.5,-2.5 z" />

    <!-- Bottom-right (equals, amber) -->
    <path
        android:fillColor="#F5A623"
        android:pathData="M67,70 m-12,0 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0 z" />
    <path
        android:fillColor="#6B4A12"
        android:pathData="M60.5,66.4 h13 v3.1 h-13 z" />
    <path
        android:fillColor="#6B4A12"
        android:pathData="M60.5,71.9 h13 v3.1 h-13 z" />
</vector>
